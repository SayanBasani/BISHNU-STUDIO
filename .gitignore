# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing & Coverage
/coverage

# Next.js Build Outputs
/.next/
/out/
/build

# Local Database Files & Backups (Never commit private database data)
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/*.sqlite*
/data/*.dump
/data/*.sql
/data/*.backup
/data/*.dump.gz

# Uploads & Customer Private Documents
/uploads/*
!/uploads/.gitkeep

# Credentials, Private Keys & Certificates
*.pem
*.key
*.cert
*.crt

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Configuration Files (Contains secrets, API keys, passwords)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript & Build Cache
*.tsbuildinfo
next-env.d.ts
