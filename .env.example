# ==============================================================================
# BISHNU STUDIO — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel / hosting dashboard for production.
# NEVER commit .env or .env.local containing real passwords to version control.
# ==============================================================================

# Application Runtime
APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# NEON MANAGED POSTGRESQL (Production & Staging)
# ------------------------------------------------------------------------------
# Obtain from Neon Console: https://console.neon.tech/ -> Your Project -> Connect
#
# 1. DATABASE_URL: Pooled connection string for serverless application traffic.
#    Used by Next.js App Router and @neondatabase/serverless HTTP driver.
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-project-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Direct (non-pooled) connection string for migration tooling.
#    Used by Drizzle Kit schema migrations when executing DDL commands.
DIRECT_URL="postgresql://USER:PASSWORD@ep-your-project.region.aws.neon.tech/neondb?sslmode=require"

# 3. TARGET_DATABASE_URL: Optional override for the SQLite-to-Neon data migrator.
#    (Leave unset to default to DATABASE_URL during 'npm run db:migrate-neon')
# TARGET_DATABASE_URL="postgresql://USER:PASSWORD@ep-your-project.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# LOCAL SQLITE DEVELOPMENT FALLBACK (Offline only)
# ------------------------------------------------------------------------------
# If running completely offline without a Neon database, un-comment below:
# DATABASE_URL=file:./data/bishnu.db

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURE SESSIONS
# ------------------------------------------------------------------------------
# Strong 32+ character random string for cryptographic session signing.
# Generate on Linux/macOS with: openssl rand -base64 32
SESSION_SECRET="your-super-secret-session-encryption-key-min-32-chars-long"
SESSION_MAX_AGE_DAYS=14

# ------------------------------------------------------------------------------
# ADMIN OWNER BOOTSTRAP CREDENTIALS
# ------------------------------------------------------------------------------
# Initial administrator credentials used for first-time account setup.
# After first login, rotate your password in /admin/settings/security.
ADMIN_NAME="Admin Name"
ADMIN_EMAIL="admin@gamil.com"
ADMIN_PHONE="9991115550"
ADMIN_PASSWORD="ReplaceWithAStrongSecureAdminPassword2026!"

# ------------------------------------------------------------------------------
# UPLOAD & FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Driver: "local" (default for dev) or "s3" (for Cloudflare R2 / AWS S3 / MinIO)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
MAX_PHOTO_SIZE_MB=10

# S3 / Cloudflare R2 / MinIO Compatible Storage (Recommended for serverless production)
# S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="bishnu-documents-private"
# S3_ACCESS_KEY_ID="your-r2-access-key-id"
# S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS & OTP PROVIDER (Optional - Simulates in development)
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Bishnu Studio <no-reply@bishnustudio.com>"

# ------------------------------------------------------------------------------
# SMS OTP NOTIFICATIONS (Optional - Simulates in development)
# ------------------------------------------------------------------------------
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID="your-twilio-account-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_FROM_PHONE="+1234567890"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Optional - Default manual UPI QR verification is active)
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID="rzp_test_your_key_id"
# RAZORPAY_KEY_SECRET="your_razorpay_secret"
